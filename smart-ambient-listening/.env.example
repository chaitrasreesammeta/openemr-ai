# Copy to .env and edit. Consumed by docker-compose.yml.

# Public address Caddy serves on.
#   localhost         -> self-signed cert (browser warning; fine for local testing)
#   emr.example.com   -> automatic Let's Encrypt cert (needs public ports 80/443 + DNS A record)
SITE_ADDRESS=localhost

# ---- OpenEMR / MariaDB ----
# Match these to whatever your restored databasevolume was created with.
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=openemr
MYSQL_PASS=openemr
MYSQL_DATABASE=openemr
OE_USER=admin
OE_PASS=pass

# Internal URL the Python services use to reach OpenEMR for token validation / user settings.
# The services call it with TLS verification disabled, so the self-signed cert is fine.
OPENEMR_SERVER_URL=https://openemr
